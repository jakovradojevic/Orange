#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Orange.manifest"

100 ICON "100.ico"

101 BITMAP "101.bmp"
102 BITMAP "102.bmp"
103 BITMAP "103.bmp"
104 BITMAP "104.bmp"
105 BITMAP "105.bmp"
106 BITMAP "106.bmp"
107 BITMAP "107.bmp"
108 BITMAP "108.bmp"
109 BITMAP "109.bmp"
110 BITMAP "110.bmp"
111 BITMAP "111.bmp"

113 WAVE "113.wav"
114 WAVE "114.wav"
115 WAVE "115.wav"
116 WAVE "116.wav"
117 WAVE "117.wav"
118 WAVE "118.wav"

107 DIALOGEX 0, 0, 210, 138
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Options", -1, 8, 6, 120, 124
    CONTROL "Gravity", 1001, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 18, 24, 100, 14
    CONTROL "Sound On", 1002, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 18, 44, 100, 14
    CONTROL "Always Active", 1003, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 18, 64, 100, 14
    CONTROL "Always on top", 1004, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 18, 84, 100, 14
    DEFPUSHBUTTON "OK", IDOK, 138, 12, 62, 16
    PUSHBUTTON "Cancel", IDCANCEL, 138, 34, 62, 16
    PUSHBUTTON "&Help", 4, 138, 56, 62, 16
    PUSHBUTTON "Exit", 3, 138, 106, 62, 16
END

108 DIALOGEX 0, 0, 292, 228
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Animations"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Action", -1, 12, 10, 160, 12
    LISTBOX 1040, 12, 24, 168, 172, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_CHILD | WS_VISIBLE | WS_BORDER
    GROUPBOX "Nudge", -1, 192, 18, 88, 100
    PUSHBUTTON "Up", 1032, 218, 36, 36, 20, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Left", 1034, 200, 60, 36, 20
    PUSHBUTTON "Right", 1035, 240, 60, 36, 20
    PUSHBUTTON "Down", 1033, 218, 84, 36, 20
    LTEXT "Pick an action to play it right away.", -1, 192, 128, 88, 48
    DEFPUSHBUTTON "OK", IDOK, 230, 196, 50, 20, WS_GROUP
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Orange"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Orange"
            VALUE "OriginalFilename", "Orange.exe"
            VALUE "ProductName", "Orange"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
